# Server Configuration
PORT=3003
# Single-service hosting: serve the production frontend from this API process.
SERVE_FRONTEND=false
# Set the public HTTPS frontend origin in hosted environments.
FRONTEND_ORIGIN=
DATABASE_SSL=true

# Database Connection (PostgreSQL / Supabase Direct Connection String)
DATABASE_URL=postgresql://username:password@hostname:5432/dbname

# JWT Authentication Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Email: lambda or ses use HTTPS on Render Free; smtp requires outbound SMTP.
EMAIL_PROVIDER=smtp
EMAIL_LAMBDA_FUNCTION=
EMAIL_FROM=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Required only with temporary AWS credentials.
AWS_SESSION_TOKEN=

# Private Amazon S3 bucket for listing photos (same server-side AWS credentials).
S3_PHOTO_BUCKET=
S3_REGION=us-east-1
# Gmail SMTP settings for local smtp; for lambda set these on the function only.
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password

# Supabase Service Credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Optional grounded support AI. Leave blank to use the built-in help library.
# Select a Responses API model available in your OpenAI project.
OPENAI_API_KEY=
OPENAI_MODEL=

# Calling stays in preview until explicitly configured for live operation.
CALLS_MODE=preview
CALLS_SCHEDULER_ENABLED=false
CALLS_PROVIDER=twilio
# Authkey activation requires approved student/startup credits and Voice access.
# Never enable paid billing or automatic recharge for the free-credit setup.
AUTHKEY_API_KEY=
AUTHKEY_VOICE_APPROVED=false
# Approved Voice OTP template containing {#2fa#}; no SMS is sent.
AUTHKEY_OTP_TEMPLATE_ID=
# Optional approved voice template containing {#message#}.
AUTHKEY_VOICE_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_VERIFY_SERVICE_SID=
# Public HTTPS backend origin used for signed Twilio webhooks. No trailing slash.
PUBLIC_API_URL=

# Twilio trials reject advanced call parameters.
TWILIO_TRIAL_MODE=false
# Random 32+ character token for the private external scheduler endpoint.
CALLS_SCHEDULER_SECRET=
